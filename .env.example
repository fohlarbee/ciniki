# Required: Claude API key for the agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Required: free key from https://developers.jup.ag/portal (swaps, lend, borrow, DCA, limit orders)
JUPITER_API_KEY=

# Strongly recommended: a dedicated Solana mainnet RPC (Helius, Triton, QuickNode...).
# The public endpoint is rate limited and will make portfolio loading unreliable.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Free-tier usage cap per wallet per day (AI messages)
DAILY_FREE_MESSAGES=25

NEXT_PUBLIC_APP_NAME=Ciniki
